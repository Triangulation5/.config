[Desktop Entry]
Type=Application
Version=1.0
Name=Silhouette Settings
GenericName=Shell Settings
Comment=Look, input, displays and backups for the Silhouette shell
Exec=qs -c silhouette-shell ipc call settings toggle
Icon=silhouette-settings
Terminal=false
Categories=Settings;DesktopSettings;Qt;
Keywords=settings;silhouette;shell;hyprland;quickshell;backup;
# The file name *is* the app id, and that is the point of it: Quickshell's
# toplevels report themselves as `org.quickshell` (a constant in the compositor
# library, not something a config can set), and everything that puts an icon
# beside a window looks the app id up as a desktop entry id. The pill's window
# list does exactly that — `DesktopEntries` entry id, then its `Icon`, then the
# icon theme — so without this name the dialog wears whatever generic the lookup
# falls back to. Same for the window rule in modules/window-rules.lua, which
# matches on this class and the title below.
StartupWMClass=org.quickshell
# The dialog is a toplevel the always-running shell already owns, so this entry
# shows, focuses and hides one window rather than starting a process. It is not
# `SingleMainWindow` for that reason: there is nothing here to launch twice.
